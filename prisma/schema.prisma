generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum StressLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  avatarUrl     String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  pseudo        String    @unique
  cguAcceptedAt DateTime?

  refreshTokens    RefreshToken[]
  articles         Article[]
  diagnostics      StressDiagnostic[]
  favoriteArticles Article[]          @relation("UserFavorites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model Article {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  content     String
  excerpt     String?
  imageUrl    String?
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  categories  Category[]
  favoritedBy User[]     @relation("UserFavorites")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]
}

model StressQuestion {
  id          String   @id @default(uuid())
  label       String
  description String?
  order       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  answers           StressAnswer[]
  diagnosticAnswers StressDiagnosticAnswer[]

  @@unique([order])
  @@index([isActive, order])
}

model StressAnswer {
  id         String         @id @default(uuid())
  label      String
  weight     Int
  order      Int
  isActive   Boolean        @default(true)
  questionId String
  question   StressQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  stressDiagnosticAnswers StressDiagnosticAnswer[]

  @@unique([questionId, order])
}

model StressDiagnostic {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  level     StressLevel
  createdAt DateTime    @default(now())

  answers StressDiagnosticAnswer[]

  @@index([userId])
}

model StressDiagnosticAnswer {
  id           String           @id @default(uuid())
  diagnosticId String
  diagnostic   StressDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)

  questionId String
  question   StressQuestion @relation(fields: [questionId], references: [id])

  answerId String
  answer   StressAnswer @relation(fields: [answerId], references: [id])

  @@unique([diagnosticId, questionId])
}
